# Copy this file to "local.properties" (same folder) and fill in the path
# to your local Flutter SDK and Android SDK installs.
# This file is auto-generated by Flutter tooling on first run in most
# setups, but is provided here in case it isn't.
sdk.dir=/path/to/your/Android/sdk
flutter.sdk=/path/to/your/flutter
flutter.versionCode=1
flutter.versionName=1.0.0
